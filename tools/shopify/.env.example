# Shopify Admin API - truy cap truc tiep bang token (khong qua OAuth cua app).
# Copy file nay thanh .env roi dien gia tri that. .env da bi .gitignore chan.
#
# Domain dang <ten-shop>.myshopify.com, KHONG kem https://
SHOPIFY_DOMAIN=
# Admin API access token cua custom app (bat dau bang shpat_).
# Lay tai: Shopify admin > Settings > Apps and sales channels
#          > Develop apps > <app> > API credentials
SHOPIFY_ACCESS_TOKEN=
# Tham khao thoi - scope that do Shopify cap khi cai app quyet dinh.
SHOPIFY_SCOPES=
