# ── Shopify app credentials ──────────────────────────────────────────────────
# From your app in the Shopify Partner dashboard (or `shopify app env show`).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-tunnel.trycloudflare.com
SCOPES=read_products,write_products,read_orders,write_orders,read_fulfillments,write_fulfillments,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders,read_inventory,write_inventory,read_locations,read_customers,write_draft_orders,read_price_rules,write_price_rules
SHOP_CUSTOM_DOMAIN=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dropship:dropship@localhost:5432/dropship_hub?schema=public

# ── Queue (BullMQ) ───────────────────────────────────────────────────────────
# Leave REDIS_URL empty to run jobs inline in the web process (dev only).
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=dropship-hub
RUN_WORKER_IN_WEB=false

# ── Suppliers ────────────────────────────────────────────────────────────────
# Set SUPPLIER_DRIVER=mock to develop the whole flow with no upstream credentials.
SUPPLIER_DRIVER=mock

# AliExpress Open Platform (https://openservice.aliexpress.com) — DS API
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_REDIRECT_URI=
ALIEXPRESS_API_BASE=https://api-sg.aliexpress.com/sync
ALIEXPRESS_AUTH_BASE=https://api-sg.aliexpress.com/oauth
ALIEXPRESS_TRACKING_ID=

# CJ Dropshipping (https://developers.cjdropshipping.com)
CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
CJ_EMAIL=
CJ_API_KEY=

# ── AI assistance (optional) ─────────────────────────────────────────────────
# With a key set, hard variant mappings are resolved by Claude; without one the
# deterministic matcher runs alone and you confirm the rest by hand.
ANTHROPIC_API_KEY=
AI_MAPPING_MODEL=claude-opus-5

# ── Misc ─────────────────────────────────────────────────────────────────────
# 32-byte key (base64) used to encrypt supplier tokens at rest.
ENCRYPTION_KEY=
LOG_LEVEL=info
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
