{
  "name": "dropship-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Full-featured AliExpress dropshipping automation app for Shopify (DSers-style)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "dev:remix": "remix vite:dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "start": "node --env-file-if-exists=.env ./node_modules/@remix-run/serve/dist/cli.js ./build/server/index.js",
    "worker": "node --env-file-if-exists=.env --import tsx/esm ./worker/main.ts",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "prisma": "prisma",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node --import tsx/esm prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "node --import tsx/esm ./scripts/demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/client": "^6.19.3",
    "@remix-run/dev": "^2.17.5",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "@shopify/admin-api-client": "^2.0.0",
    "@shopify/app-bridge-react": "^4.2.13",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify-api": "^14.0.1",
    "@shopify/shopify-app-remix": "^5.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.1",
    "bullmq": "^5.81.4",
    "decimal.js": "^10.6.0",
    "ioredis": "^5.11.1",
    "isbot": "^5.2.2",
    "nodemailer": "^10.0.1",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tiny-invariant": "^1.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.16.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "prisma": {
    "seed": "node --import tsx/esm prisma/seed.ts"
  }
}
