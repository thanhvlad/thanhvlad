{
  "manifest_version": 3,
  "name": "DropshipHub Product Capture",
  "version": "1.0.0",
  "description": "Send the AliExpress or CJ product you are viewing to your DropshipHub import list.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*", "https://cjdropshipping.com/*", "https://*.cjdropshipping.com/*"],
  "action": {
    "default_title": "Add to DropshipHub",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {}
}
